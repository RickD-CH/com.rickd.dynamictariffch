{
  "id": "com.rickd.dynamictariffch",
  "version": "0.3.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Swiss Dynamic Tariff & EMS",
    "de": "Dynamischer Stromtarif CH & EMS",
    "fr": "Tarif électrique dynamique CH",
    "it": "Tariffa elettrica dinamica CH"
  },
  "description": {
    "en": "Run your home on the cheapest Swiss electricity, with built-in energy management",
    "de": "Dein Zuhause nutzt Strom, wenn er am günstigsten ist, mit eigenem Energiemanagement",
    "fr": "Faites tourner votre maison quand l'électricité suisse est la moins chère",
    "it": "Fai funzionare la tua casa quando l'elettricità svizzera costa meno"
  },
  "tags": {
    "en": [
      "dynamic electricity price",
      "electricity tariff",
      "energy",
      "Switzerland",
      "AEW",
      "Innostrom",
      "Swisspower",
      "spot price",
      "energy management",
      "EMS",
      "EV charger"
    ],
    "de": [
      "dynamischer Stromtarif",
      "Strompreis",
      "Energie",
      "Schweiz",
      "AEW",
      "Innostrom",
      "Swisspower",
      "Spotpreis",
      "Energiemanagement",
      "EMS",
      "Wallbox"
    ],
    "fr": [
      "tarif électrique dynamique",
      "prix de l'électricité",
      "énergie",
      "Suisse",
      "AEW",
      "Innostrom",
      "Swisspower",
      "prix spot"
    ],
    "it": [
      "tariffa elettrica dinamica",
      "prezzo dell'elettricità",
      "energia",
      "Svizzera",
      "AEW",
      "Innostrom",
      "Swisspower",
      "prezzo spot"
    ]
  },
  "category": "energy",
  "brandColor": "#0277BD",
  "permissions": [
    "homey:manager:api",
    "homey:app:com.huawei.fusionsolar"
  ],
  "source": "https://github.com/RickD-CH/com.rickd.dynamictariffch",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.dynamictariffch/issues"
  },
  "author": {
    "name": "Richard Dubs"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "getSummary": {
      "method": "get",
      "path": "/summary"
    },
    "getCost": {
      "method": "get",
      "path": "/cost"
    },
    "putCostConfig": {
      "method": "put",
      "path": "/cost/config"
    },
    "resetCost": {
      "method": "post",
      "path": "/cost/reset"
    },
    "getAppConfig": {
      "method": "get",
      "path": "/config"
    },
    "putAppConfig": {
      "method": "put",
      "path": "/config"
    },
    "deleteCostData": {
      "method": "post",
      "path": "/cost/delete"
    },
    "getShadow": {
      "method": "get",
      "path": "/cost/shadow"
    },
    "getPrices": {
      "method": "get",
      "path": "/prices"
    },
    "getCostChart": {
      "method": "get",
      "path": "/cost/chart/:offset"
    },
    "getBackupStatus": {
      "method": "get",
      "path": "/backup"
    },
    "saveBackup": {
      "method": "post",
      "path": "/backup/save"
    },
    "exportBackup": {
      "method": "post",
      "path": "/backup/export"
    },
    "inspectBackup": {
      "method": "post",
      "path": "/backup/inspect"
    },
    "restoreBackup": {
      "method": "post",
      "path": "/backup/restore"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "testDigest": {
      "method": "post",
      "path": "/test/digest"
    },
    "testReportsMissing": {
      "method": "post",
      "path": "/test/reports"
    },
    "getEmsShadow": {
      "method": "get",
      "path": "/ems/shadow"
    },
    "getEmsPlan": {
      "method": "get",
      "path": "/ems/plan"
    },
    "getEmsJobs": {
      "method": "get",
      "path": "/ems/jobs"
    },
    "postEmsJob": {
      "method": "post",
      "path": "/ems/jobs"
    },
    "deleteEmsJob": {
      "method": "delete",
      "path": "/ems/jobs/:id"
    },
    "postEmsPlanPreview": {
      "method": "post",
      "path": "/ems/plan/preview"
    },
    "postEmsRun": {
      "method": "post",
      "path": "/ems/run"
    },
    "postEmsResetData": {
      "method": "post",
      "path": "/ems/reset-data"
    },
    "getEmsConfig": {
      "method": "get",
      "path": "/ems/config"
    },
    "putEmsConfig": {
      "method": "put",
      "path": "/ems/config"
    },
    "getEmsDevices": {
      "method": "get",
      "path": "/ems/devices"
    },
    "getEmsFlows": {
      "method": "get",
      "path": "/ems/flows"
    },
    "getEmsDeviceCards": {
      "method": "get",
      "path": "/ems/device-cards"
    },
    "getEmsBatteryCards": {
      "method": "get",
      "path": "/ems/battery-cards"
    },
    "getEmsConsumers": {
      "method": "get",
      "path": "/ems/consumers"
    },
    "putEmsToggle": {
      "method": "put",
      "path": "/ems/toggle"
    },
    "getMeters": {
      "method": "get",
      "path": "/meters"
    },
    "putMeters": {
      "method": "put",
      "path": "/meters"
    },
    "postMetersRun": {
      "method": "post",
      "path": "/meters/run"
    },
    "getMetersDevices": {
      "method": "get",
      "path": "/meters/devices"
    }
  },
  "support": "https://community.homey.app/t/160031",
  "homeyCommunityTopicId": 160031,
  "contributing": {
    "donate": {
      "paypal": {
        "username": "RickDch"
      }
    }
  }
}
