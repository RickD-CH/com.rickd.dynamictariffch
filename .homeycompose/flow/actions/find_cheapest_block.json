{
  "title": {
    "en": "Find the cheapest block",
    "de": "Günstigsten Block finden",
    "fr": "Trouver le bloc le moins cher",
    "it": "Trova il blocco più conveniente"
  },
  "titleFormatted": {
    "en": "Find the cheapest block of [[hours]] hours between [[from]] and [[to]]",
    "de": "Finde den günstigsten Block von [[hours]] Stunden zwischen [[from]] und [[to]]",
    "fr": "Trouver le bloc le moins cher de [[hours]] heures entre [[from]] et [[to]]",
    "it": "Trova il blocco più conveniente di [[hours]] ore tra le [[from]] e le [[to]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=innostrom"
    },
    {
      "type": "number",
      "name": "hours",
      "title": {
        "en": "Duration (hours)",
        "de": "Dauer (Stunden)",
        "fr": "Durée (heures)",
        "it": "Durata (ore)"
      },
      "min": 0.25,
      "max": 24,
      "step": 0.25
    },
    {
      "type": "time",
      "name": "from",
      "title": {
        "en": "From",
        "de": "Von",
        "fr": "De",
        "it": "Da"
      }
    },
    {
      "type": "time",
      "name": "to",
      "title": {
        "en": "To",
        "de": "Bis",
        "fr": "À",
        "it": "A"
      }
    }
  ],
  "tokens": [
    {
      "name": "start",
      "type": "string",
      "title": {
        "en": "Block starts",
        "de": "Block beginnt",
        "fr": "Début du bloc",
        "it": "Inizio del blocco"
      },
      "example": "02:00"
    },
    {
      "name": "end",
      "type": "string",
      "title": {
        "en": "Block ends",
        "de": "Block endet",
        "fr": "Fin du bloc",
        "it": "Fine del blocco"
      },
      "example": "05:00"
    },
    {
      "name": "avg",
      "type": "number",
      "title": {
        "en": "Average price",
        "de": "Durchschnittspreis",
        "fr": "Prix moyen",
        "it": "Prezzo medio"
      },
      "example": 17.8
    }
  ]
}
