{
  "title": {
    "en": "Set the EV target for today or tomorrow",
    "de": "Ziel des E-Autos für heute oder morgen setzen",
    "fr": "Définir l’objectif de la voiture pour aujourd’hui ou demain",
    "it": "Imposta l’obiettivo dell’auto per oggi o domani"
  },
  "titleFormatted": {
    "en": "EV: [[day]] [[soc]] % by [[time]], charge [[charge]]",
    "de": "E-Auto: [[day]] [[soc]] % bis [[time]], laden [[charge]]",
    "fr": "Voiture : [[day]] [[soc]] % d’ici [[time]], charge [[charge]]",
    "it": "Auto: [[day]] [[soc]] % entro le [[time]], carica [[charge]]"
  },
  "hint": {
    "en": "Overrides the weekly template on that day.",
    "de": "Übersteuert die Wochenvorlage an diesem Tag.",
    "fr": "Remplace le modèle hebdomadaire pour ce jour.",
    "it": "Sostituisce il modello settimanale per quel giorno."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=ems"
    },
    {
      "type": "dropdown",
      "name": "day",
      "title": {
        "en": "Day",
        "de": "Tag",
        "fr": "Jour",
        "it": "Giorno"
      },
      "values": [
        {
          "id": "today",
          "title": {
            "en": "today",
            "de": "heute",
            "fr": "aujourd’hui",
            "it": "oggi"
          }
        },
        {
          "id": "tomorrow",
          "title": {
            "en": "tomorrow",
            "de": "morgen",
            "fr": "demain",
            "it": "domani"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "soc",
      "title": {
        "en": "Target (%)",
        "de": "Ziel (%)",
        "fr": "Objectif (%)",
        "it": "Obiettivo (%)"
      },
      "min": 10,
      "max": 100,
      "step": 5
    },
    {
      "type": "time",
      "name": "time",
      "title": {
        "en": "Departure",
        "de": "Abfahrt",
        "fr": "Départ",
        "it": "Partenza"
      }
    },
    {
      "type": "dropdown",
      "name": "charge",
      "title": {
        "en": "Charge",
        "de": "Laden",
        "fr": "Charge",
        "it": "Carica"
      },
      "values": [
        {
          "id": "yes",
          "title": {
            "en": "yes",
            "de": "ja",
            "fr": "oui",
            "it": "sì"
          }
        },
        {
          "id": "no",
          "title": {
            "en": "no",
            "de": "nein",
            "fr": "non",
            "it": "no"
          }
        }
      ]
    }
  ]
}
