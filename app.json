        "hint": {
          "en": "Fires only at the moment the price crosses above the threshold, not on every slot while it stays above.",
          "de": "Löst nur im Moment des Überschreitens aus, nicht bei jeder Viertelstunde, in der der Preis darüber bleibt."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=innostrom"
          },
          {
            "type": "number",
            "name": "price",
            "title": {
              "en": "Price (Rp./kWh)",
              "de": "Preis (Rp./kWh)"
