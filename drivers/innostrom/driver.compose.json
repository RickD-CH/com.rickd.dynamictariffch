{
  "id": "innostrom",
  "name": {
    "en": "Innostrom dynamic tariff",
    "de": "Innostrom dynamischer Tarif"
  },
  "class": "sensor",
  "capabilities": [
    "measure_price_total",
    "measure_price_energy",
    "measure_price_grid",
    "measure_price_next",
    "measure_price_min_today",
    "measure_price_max_today",
    "measure_price_avg_today",
    "price_rank_today",
    "price_level",
    "alarm_no_tomorrow",
    "alarm_reports_missing",
    "last_update"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "{{driverAssetsPath}}/pair-logo.png",
        "usernameLabel": {
          "en": "Metering point number",
          "de": "Messpunktnummer"
        },
        "usernameHint": {
          "en": "CH… number, 33 characters, as provided by your utility. Enter your own credentials.",
          "de": "CH…-Nummer, 33 Zeichen, von deinem Netzbetreiber. Bitte die eigenen Zugangsdaten eingeben."
        },
        "passwordLabel": {
          "en": "API token",
          "de": "API-Token"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "{{driverAssetsPath}}/pair-logo.png",
        "usernameLabel": {
          "en": "Metering point number",
          "de": "Messpunktnummer"
        },
        "usernameHint": {
          "en": "Must match this device's metering point - use device settings instead to switch to a different metering point.",
          "de": "Muss mit der Messpunktnummer dieses Geräts übereinstimmen - für einen anderen Messpunkt stattdessen neu koppeln."
        },
        "passwordLabel": {
          "en": "API token",
          "de": "API-Token"
        }
      }
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Access",
        "de": "Zugang"
      },
      "children": [
        {
          "id": "metering_code",
          "type": "label",
          "label": {
            "en": "Metering point number",
            "de": "Messpunktnummer"
          },
          "value": ""
        },
        {
          "id": "token",
          "type": "password",
          "label": {
            "en": "API token",
            "de": "API-Token"
          },
          "value": ""
        },
        {
          "id": "environment",
          "type": "dropdown",
          "label": {
            "en": "Environment",
            "de": "Umgebung"
          },
          "value": "production",
          "values": [
            {
              "id": "production",
              "label": {
                "en": "Production",
                "de": "Produktiv"
              }
            },
            {
              "id": "test",
              "label": {
                "en": "Test",
                "de": "Test"
              }
            }
          ],
          "hint": {
            "en": "Test uses the public Innostrom test environment with constant prices, useful to verify the connection without a contract.",
            "de": "Test verwendet die öffentliche Innostrom-Testumgebung mit konstanten Preisen, nützlich um die Verbindung ohne Vertrag zu prüfen."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Price",
        "de": "Preis"
      },
      "children": [
        {
          "id": "price_field",
          "type": "dropdown",
          "label": {
            "en": "Price used for Flows",
            "de": "Preis für Flows"
          },
          "value": "integrated",
          "values": [
            {
              "id": "integrated",
              "label": {
                "en": "Total (energy + grid)",
                "de": "Gesamt (Energie + Netz)"
              }
            },
            {
              "id": "electricity",
              "label": {
                "en": "Energy only",
                "de": "Nur Energie"
              }
            },
            {
              "id": "grid",
              "label": {
                "en": "Grid only (incl. levies)",
                "de": "Nur Netz (inkl. Abgaben)"
              }
            }
          ]
        },
        {
          "id": "fallback_price",
          "type": "number",
          "label": {
            "en": "Fallback price (CHF/kWh)",
            "de": "Einheitstarif (CHF/kWh)"
          },
          "value": 0,
          "min": 0,
          "hint": {
            "en": "Used when no price data is available (e.g. missing tomorrow prices). 0 = show nothing instead.",
            "de": "Wird verwendet, wenn keine Preisdaten vorliegen (z. B. fehlende Preise für morgen). 0 = stattdessen nichts anzeigen."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Price level thresholds",
        "de": "Schwellen für Preisniveau"
      },
      "children": [
        {
          "id": "level_very_cheap_percent",
          "type": "number",
          "label": {
            "en": "Very cheap below (% of daily average)",
            "de": "Sehr günstig unter (% vom Tagesmittel)"
          },
          "value": 75,
          "min": 1,
          "max": 100
        },
        {
          "id": "level_cheap_percent",
          "type": "number",
          "label": {
            "en": "Cheap below (% of daily average)",
            "de": "Günstig unter (% vom Tagesmittel)"
          },
          "value": 90,
          "min": 1,
          "max": 100
        },
        {
          "id": "level_expensive_percent",
          "type": "number",
          "label": {
            "en": "Expensive above (% of daily average)",
            "de": "Teuer über (% vom Tagesmittel)"
          },
          "value": 110,
          "min": 100,
          "max": 500
        },
        {
          "id": "level_very_expensive_percent",
          "type": "number",
          "label": {
            "en": "Very expensive above (% of daily average)",
            "de": "Sehr teuer über (% vom Tagesmittel)"
          },
          "value": 125,
          "min": 100,
          "max": 500
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Displayed values",
        "de": "Angezeigte Werte"
      },
      "children": [
        {
          "id": "show_costs",
          "type": "dropdown",
          "value": "auto",
          "label": {
            "en": "Cost values",
            "de": "Kostenwerte"
          },
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic (only if you report meters)",
                "de": "Automatisch (nur wenn du Zähler meldest)"
              }
            },
            {
              "id": "always",
              "label": {
                "en": "Always",
                "de": "Immer"
              }
            },
            {
              "id": "never",
              "label": {
                "en": "Never",
                "de": "Nie"
              }
            }
          ],
          "hint": {
            "en": "Cost today, cost with the previous tariff, savings today and this month and average import price. Turning them off removes the values from the device, their history in Insights is lost and Flows that use them stop working.",
            "de": "Kosten heute, Kosten mit bisherigem Tarif, Ersparnis heute und Monat und Ø Bezugspreis. Beim Ausschalten werden die Werte vom Gerät entfernt, ihr Verlauf in den Insights geht verloren und Flows, die sie benutzen, funktionieren nicht mehr."
          }
        },
        {
          "id": "show_feedin",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Feed-in price",
            "de": "Einspeisevergütung"
          },
          "hint": {
            "en": "Shows the feed-in price delivered by the API. Turning it off removes the value and its Insights history.",
            "de": "Zeigt den von der API gelieferten Einspeisepreis. Beim Ausschalten werden der Wert und sein Verlauf in den Insights entfernt."
          }
        }
      ]
    }
  ]
}
